{
  "name": "gre-awa-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GRE Analytical Writing (Issue task) reviewer and writer agents",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit --project web/app/tsconfig.json",
    "test": "node --test \"packages/**/test/*.test.ts\"",
    "eval": "node packages/eval/run.ts",
    "build": "vite build --config web/vite.config.ts",
    "dev": "npm run build && wrangler dev --config web/wrangler.jsonc --port 8788",
    "dev:ui": "vite --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy --config web/wrangler.jsonc",
    "images": "node tools/make-social-images.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  }
}
