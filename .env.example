# Copy this file to .env and fill in the values you need.
# .env is gitignored. Never commit a real key.
#
# You do NOT need both providers. The agent code goes through a provider
# abstraction, so either one is enough to start; set both only when you want
# to A/B them on the eval harness.

# --- Anthropic ---------------------------------------------------------
# Get one at https://platform.claude.com/ -> API keys. Starts with sk-ant-.
#
# Alternative with no key in a file at all: run `ant auth login` once, which
# stores an OAuth profile under %APPDATA%\Anthropic that the SDK picks up
# automatically. Leave this blank if you go that route.
ANTHROPIC_API_KEY=

# --- Google Gemini (optional, for the dev-loop free tier) --------------
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Defaults ----------------------------------------------------------
# Which provider the agents use unless a call overrides it.
LLM_PROVIDER=anthropic
REVIEWER_MODEL=claude-sonnet-5
WRITER_MODEL=claude-opus-5
